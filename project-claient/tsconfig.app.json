{
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "baseUrl": "./",
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "src/*": ["src/*"],
      "primeng/*": ["node_modules/primeng/*"],
      "@primeuix/themes/*": ["node_modules/@primeuix/themes/*"]
    },
    "ignoreDeprecations": "5.0",
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}